# Supabase project URL (public)
SUPABASE_URL=

# Supabase anon/publishable key (public, safe for the browser bundle)
SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key — server-only, bypasses RLS. NEVER expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI key — server-only. Used by the remaining reading/video/pronunciation
# server functions that generate AI content directly (not yet migrated to
# learningcoachbackEnd). Optional — those specific features error clearly if unset.
OPENAI_API_KEY=

# Base URL of the learningcoachbackEnd API, used by src/lib/api/client.ts
VITE_API_URL=http://localhost:8787

# Production domain, once you have one — used for canonical URLs/sitemap.
VITE_SITE_URL=https://learningcoach.co.ao/
